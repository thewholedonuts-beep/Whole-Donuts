# WholeDonut Funnel Management - Environment Variables
# Copy this file to .env and fill in your actual values

# Porkbun API Credentials
# Get these from https://porkbun.com/account/api
PORKBUN_API_KEY=your_api_key_here
PORKBUN_SECRET_KEY=your_secret_key_here

# Funnel Configuration
# Path to your funnels configuration file
FUNNEL_CONFIG=config/funnels.yaml

# Email Provider Settings
# SendGrid
SENDGRID_API_KEY=your_sendgrid_key
SENDGRID_SENDER=noreply@wholedonuts.org

# Mailchimp
MAILCHIMP_API_KEY=your_mailchimp_key
MAILCHIMP_DATACENTER=us1

# ActiveCampaign
ACTIVECAMPAIGN_API_KEY=your_activecampaign_key
ACTIVECAMPAIGN_URL=https://your-account.api-us1.com

# Server Configuration
# Your server IP addresses for funnel routing
SERVER_IP_1=192.168.1.100
SERVER_IP_2=192.168.1.101
SERVER_IP_3=192.168.1.102

# Logging
LOG_LEVEL=info
LOG_FILE=funnel-deployment.log
